{
    "name": "condoedge/projects",
    "description": "Project management module (suggestions, feature requests, tasks, kanban, gantt, GitHub sync) for Kompo/Laravel applications",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Condoedge\\Projects\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "laravel/framework": ">=10.0",
        "kompo/auth": ">=0.4",
        "condoedge/utils": "*"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Condoedge\\Projects\\ProjectsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
